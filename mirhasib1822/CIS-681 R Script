library(modelsummary)
library(ggeffects)
library(ggplot2)

coef_labels <- c(
  "care_transition_primary" = "Care Transition (linear score)",
  "care_transition_z" = "Care Transition (standardized)",
  "care_transition_topbox" = "Care Transition (% top-box)",
  "care_transition_c" = "Care Transition (centered)",
  "care_transition_c2" = "Care Transition (centered)",
  "discharge_info_c" = "Discharge Information (centered)",
  "care_transition_c:condition_groupSurgical" = "Care Transition x Surgical",
  "care_transition_primary:dshpct_c" = "Care Transition x DSH Share",
  "care_transition_c2:discharge_info_c" = "Care Transition x Discharge Info",
  "condition_groupSurgical" = "Condition Group: Surgical",
  "dshpct_c" = "DSH Share (centered)",
  "log_beds" = "Log(Beds)", "log_beds_z" = "Log(Beds), standardized",
  "resident_bed_ratio" = "Resident-to-Bed Ratio",
  "resident_ratio_z" = "Resident-to-Bed Ratio, standardized",
  "DSHPCT" = "DSH Percentage", "dshpct_z" = "DSH Percentage, standardized"
)

## Table 1: Descriptive statistics
# Replace log_beds with raw BEDS in the descriptive table — log_beds stays in the regression models, unchanged
datasummary(BEDS + ERR_weighted + ERR_medical + ERR_surgical + care_transition_primary +
              discharge_info_linear + resident_bed_ratio + DSHPCT ~
              Mean + SD + Min + Max + N,
            data = model_data_primary, output = "Table1_Descriptives.docx")

# New — categorical breakdown, append right after
datasummary(`Hospital Ownership` + Region ~ N + Percent(),
            data = model_data_primary,
            output = "Table1b_CategoricalDescriptives.docx")

## Table 2: Primary model (H1) — 3 specifications
models_primary <- list("Primary (GLM)" = model_primary,
                       "Multilevel (GLMM)" = model_primary_re,
                       "Top-box robustness" = model_primary_topbox)
vcov_primary <- list(vcovCL(model_primary, cluster = model_data_primary$State),
                     vcov(model_primary_re),
                     vcovCL(model_primary_topbox, cluster = model_data_primary$State))

modelsummary(models_primary, vcov = vcov_primary,
             stars = c('*' = .05, '**' = .01, '***' = .001),
             coef_rename = coef_labels, gof_omit = "IC|Log.Lik|RMSE",
             notes = "Standard errors for the GLM specifications are clustered by state. The multilevel (GLMM) specification uses model-based standard errors.",
             output = "Table2_PrimaryModel.docx")

## Table 3: Moderation and extension models (Additions #1-3)
models_mod <- list("Condition-type (Add. 1)" = model_condition,
                   "DSH-share (Add. 2)" = model_dsh,
                   "Domain interaction (Add. 3)" = model_gap)
vcov_mod <- list(vcovCL(model_condition, cluster = model_data_long$`Facility ID`),
                 vcovCL(model_dsh, cluster = model_data_primary$State),
                 vcovCL(model_gap, cluster = model_data_gap$State))

modelsummary(models_mod, vcov = vcov_mod,
             stars = c('*' = .05, '**' = .01, '***' = .001),
             coef_rename = coef_labels, gof_omit = "IC|Log.Lik|RMSE",
             notes = "Standard errors clustered by facility ID (Addition 1, two rows per hospital) or by state (Additions 2-3).",
             output = "Table3_ModerationModels.docx")

## Figure 1: Addition #1 — Care Transition x Condition Type
pred_condition <- ggpredict(model_condition, terms = c("care_transition_c [all]", "condition_group"),
                            vcov.fun = "vcovCL", vcov.args = list(cluster = model_data_long$`Facility ID`))
plot(pred_condition) +
  labs(title = "Predicted ERR by Care Transition Score and Condition Type",
       x = "Care Transition Score (centered)", y = "Predicted ERR", color = "Condition Group") +
  theme_minimal() + scale_color_viridis_d()
ggsave("Figure1_ConditionInteraction.png", width = 9, height = 5.5, dpi = 300)

## Figure 2: Addition #2 — Care Transition x DSH Share
pred_dsh <- ggpredict(model_dsh, terms = c("care_transition_primary [all]", "dshpct_c [meansd]"),
                      vcov.fun = "vcovCL", vcov.args = list(cluster = model_data_primary$State))
plot(pred_dsh) +
  labs(title = "Predicted ERR by Care Transition Score and DSH Share",
       x = "Care Transition Score", y = "Predicted ERR", color = "DSH Share (centered, +/-1 SD)") +
  theme_minimal() + scale_color_viridis_d()
ggsave("Figure2_DSHInteraction.png", width = 9, height = 5.5, dpi = 300)
