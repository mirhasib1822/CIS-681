> # ------------------------------------------------------------
> # Step 3 — HRRP reshape
> # safe_weighted_mean() fixes a silent data-loss bug: weighted.mean(x, w, na.rm = TRUE)
> # only drops rows where x is NA, not where w (Number of Discharges) is NA. CMS suppresses
> # discharge counts while still reporting the ratio, so the default weighted.mean() silently
> # nulled any hospital with one suppressed measure among its six. See DECISIONS.md #1.
> # ------------------------------------------------------------
> safe_weighted_mean <- function(x, w) {
+   ok <- !is.na(x) & !is.na(w)
+   if (!any(ok)) return(NA_real_)
+   weighted.mean(x[ok], w[ok])
+ }
> 
> hrrp_wide <- hrrp %>%
+   mutate(`Excess Readmission Ratio` = na_if(`Excess Readmission Ratio`, "N/A"),
+          `Excess Readmission Ratio` = as.numeric(`Excess Readmission Ratio`),
+          `Number of Discharges` = na_if(`Number of Discharges`, "N/A"),
+          `Number of Discharges` = as.numeric(`Number of Discharges`)) %>%
+   select(`Facility ID`, `Measure Name`, `Excess Readmission Ratio`, `Number of Discharges`) %>%
+   pivot_wider(id_cols = `Facility ID`,
+               names_from = `Measure Name`,
+               values_from = c(`Excess Readmission Ratio`, `Number of Discharges`))
> 
> err_cols  <- grep("^Excess Readmission Ratio_", names(hrrp_wide), value = TRUE)
> disc_cols <- grep("^Number of Discharges_", names(hrrp_wide), value = TRUE)
> 
> hrrp_wide <- hrrp_wide %>%
+   rowwise() %>%
+   mutate(ERR_weighted = safe_weighted_mean(c_across(all_of(err_cols)), c_across(all_of(disc_cols)))) %>%
+   ungroup()
